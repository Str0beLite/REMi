# Node settings. `scripts/remi up` copies this to .env and fills in the name and GPU. See docs/node-setup.md.
# local = this machine runs its own SpacetimeDB + console, and `remi up` publishes the module and fills STDB_TOKEN.
# Another machine joins with `scripts/remi join <url>/<db> <code>` (Config > Add a machine), which empties
# COMPOSE_PROFILES and STDB_TOKEN and sets STDB_URL, STDB_DB and REMI_JOIN_CODE. `scripts/remi up --lan` sets
# REMI_LAN=1 and REMI_BIND=0.0.0.0 so other machines can reach this workspace.
COMPOSE_PROFILES=local
STDB_URL=http://spacetimedb:3000
STDB_DB=remi
STDB_TOKEN=
REMI_NODE_NAME=node
REMI_GPU=unknown
# LoRA slots in vLLM (default 4); extra vLLM flags, passed as-is
# REMI_MAX_LORAS=4
# VLLM_ARGS=
