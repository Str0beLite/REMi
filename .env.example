# Node settings for `scripts/remi up` (copy to .env). See docs/node-setup.md.
# SpacetimeDB the node joins. A database on Maincloud: https://maincloud.spacetimedb.com
# A local `spacetime start` on this machine: http://host.docker.internal:3000
STDB_URL=https://maincloud.spacetimedb.com
STDB_DB=remi
# An admin identity's token (register_node is admin-only, CONTRACT §4): `spacetime login show --token`
STDB_TOKEN=
REMI_NODE_NAME=node
REMI_GPU=unknown
# LoRA slots in vLLM (default 4); extra vLLM flags, passed as-is
# REMI_MAX_LORAS=4
# VLLM_ARGS=
