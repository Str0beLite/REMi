# Node settings. `scripts/remi up` copies this to .env and fills in the name and GPU. See docs/node-setup.md.
# local = this machine runs its own SpacetimeDB + console, and `remi up` publishes the module and fills STDB_TOKEN.
# Every machine runs the same `scripts/remi up`; its console then starts a new cluster or joins one (Config > Add a
# machine on the cluster gives the join link). Optional: REMI_WORKSPACE_HOST=<name or IP other machines reach this PC
# by>, REMI_BIND=127.0.0.1 to keep this machine off the network.
COMPOSE_PROFILES=local
STDB_URL=http://spacetimedb:3000
STDB_DB=remi
STDB_TOKEN=
REMI_NODE_NAME=node
REMI_GPU=unknown
# LoRA slots in vLLM (default 4); extra vLLM flags, passed as-is
# REMI_MAX_LORAS=4
# VLLM_ARGS=
