#!/usr/bin/env bash
# remi install | up [--lan|--no-lan] | join <url>/<db> <code> | down | status | logs | doctor
# Run a REMi workspace or node in Docker (docs/node-setup.md).
# `up` installs what's missing first (Docker Engine, NVIDIA Container Toolkit), so a fresh WSL2/Linux box just works.
set -uo pipefail
cd "$(dirname "$0")/.."
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"
say() { printf '\033[1mremi:\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mremi:\033[0m %s\n' "$*" >&2; exit 1; }

D="docker"  # becomes "sudo docker" when we just joined the docker group (it applies from the next login)
pick_docker() { docker info >/dev/null 2>&1 || { $SUDO docker info >/dev/null 2>&1 && D="$SUDO docker"; }; }
desktop() { $D info --format '{{.OperatingSystem}}' 2>/dev/null | grep -q "Docker Desktop"; }
gpu_ok() { $D run --rm --gpus all ubuntu:24.04 nvidia-smi -L >/tmp/remi-gpu.txt 2>&1; }
restart_docker() { $SUDO systemctl restart docker 2>/dev/null || $SUDO service docker restart; }

install_docker() {
  say "installing Docker Engine (get.docker.com)"
  curl -fsSL https://get.docker.com | $SUDO sh || die "Docker install failed"
  [ -n "$SUDO" ] && $SUDO usermod -aG docker "$USER"
  $SUDO systemctl enable --now docker 2>/dev/null || $SUDO service docker start
}

install_toolkit() {
  say "installing the NVIDIA Container Toolkit"
  local key=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg base=https://nvidia.github.io/libnvidia-container
  if command -v apt-get >/dev/null; then
    curl -fsSL $base/gpgkey | $SUDO gpg --batch --yes --dearmor -o $key
    curl -fsSL $base/stable/deb/nvidia-container-toolkit.list | sed "s#deb https://#deb [signed-by=$key] https://#g" \
      | $SUDO tee /etc/apt/sources.list.d/nvidia-container-toolkit.list >/dev/null
    $SUDO apt-get update -qq && $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nvidia-container-toolkit
  elif command -v dnf >/dev/null; then
    curl -fsSL $base/stable/rpm/nvidia-container-toolkit.repo | $SUDO tee /etc/yum.repos.d/nvidia-container-toolkit.repo >/dev/null
    $SUDO dnf install -y -q nvidia-container-toolkit
  else
    die "no apt or dnf: install the NVIDIA Container Toolkit by hand (docs/node-setup.md)"
  fi || die "NVIDIA Container Toolkit install failed"
  $SUDO nvidia-ctk runtime configure --runtime=docker && restart_docker
}

make_env() {
  [ -f .env ] && return
  cp .env.example .env
  sed -i "s/^REMI_NODE_NAME=.*/REMI_NODE_NAME=$(hostname -s | tr 'A-Z_' 'a-z-')/" .env
  local gpu; gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
  [ -n "$gpu" ] && sed -i "s/^REMI_GPU=.*/REMI_GPU=$gpu/" .env
  say "wrote .env for this machine"
}

keep_wsl_up() {  # WSL stops a distro 15 s after its last shell closes, taking Docker and the node with it
  grep -qi microsoft /proc/version || return 0
  local cfg; cfg="$(wslpath "$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')")/.wslconfig"
  grep -qi '^instanceIdleTimeout' "$cfg" 2>/dev/null && return
  if grep -qi '^\[general\]' "$cfg" 2>/dev/null; then sed -i '/^\[general\]/I a instanceIdleTimeout=-1' "$cfg"
  else printf '\n[general]\ninstanceIdleTimeout=-1\n' >>"$cfg"; fi
  say "set instanceIdleTimeout=-1 in $cfg so WSL keeps the node running when no terminal is open. It applies after you run 'wsl --shutdown' in Windows and reopen WSL."
  say "it applies after a WSL restart: run 'wsl.exe --shutdown' in Windows, then scripts/remi up again"
}

local_db() { grep -q '^COMPOSE_PROFILES=.*local' .env; }  # this machine runs the workspace's SpacetimeDB
env_get() { sed -n "s/^$1=//p" .env 2>/dev/null | tail -1; }
env_set() { if grep -q "^$1=" .env; then sed -i "s|^$1=.*|$1=$2|" .env; else echo "$1=$2" >>.env; fi; }

wsl() { grep -qi microsoft /proc/version; }
lan_ip() {  # the address other machines on the network reach this PC at
  if wsl; then
    powershell.exe -NoProfile -Command "(Get-NetIPConfiguration | Where-Object { \$_.IPv4DefaultGateway -and \$_.NetAdapter.Status -eq 'Up' } | Select-Object -First 1).IPv4Address.IPAddress" 2>/dev/null | tr -d '\r'
  else
    ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p'
  fi
}

# WSL2 (NAT mode) hides the distro behind Windows: forward 3000/8080 from Windows to WSL and allow them in the
# Windows firewall. Mirrored networking or Docker Desktop publish on Windows already, so they need the firewall only.
# Runs elevated (Windows asks once); re-run only when the WSL address changes.
open_windows_ports() {
  wsl || return 0
  local nat=1 wslip ps win
  { [ "$(wslinfo --networking-mode 2>/dev/null)" = mirrored ] || desktop; } && nat=0
  wslip=$(hostname -I | awk '{print $1}')
  [ "$(env_get REMI_LAN_DONE)" = "$nat:$wslip" ] && return 0
  win=$(cmd.exe /c 'echo %TEMP%' 2>/dev/null | tr -d '\r')
  ps="$(wslpath "$win")/remi-lan.ps1"
  {
    echo 'foreach ($p in 3000,8080) { netsh interface portproxy delete v4tov4 listenport=$p listenaddress=0.0.0.0 | Out-Null }'
    [ $nat = 1 ] && echo "foreach (\$p in 3000,8080) { netsh interface portproxy add v4tov4 listenport=\$p listenaddress=0.0.0.0 connectport=\$p connectaddress=$wslip }"
    echo "Remove-NetFirewallRule -DisplayName 'REMi workspace' -ErrorAction SilentlyContinue"
    echo "New-NetFirewallRule -DisplayName 'REMi workspace' -Direction Inbound -Protocol TCP -LocalPort 3000,8080 -Action Allow -Profile Private,Domain | Out-Null"
    [ $nat = 0 ] && echo "Remove-NetFirewallHyperVRule -Name REMi -ErrorAction SilentlyContinue" \
      && echo "New-NetFirewallHyperVRule -Name REMi -DisplayName 'REMi workspace' -Direction Inbound -VMCreatorId '{40E0AC32-46A5-438A-A0B2-2B479E8F2E90}' -Protocol TCP -LocalPorts 3000,8080 -Action Allow -ErrorAction SilentlyContinue | Out-Null"
  } >"$ps"
  say "opening ports 3000 and 8080 in Windows (it asks for admin once)"
  powershell.exe -NoProfile -Command "Start-Process powershell -Verb RunAs -Wait -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','\"$win\\remi-lan.ps1\"'" \
    || die "couldn't open the ports in Windows: run PowerShell as admin and allow TCP 3000 and 8080 inbound"
  env_set REMI_LAN_DONE "$nat:$wslip"
}

# --lan (sticky in .env) opens this workspace to the network: Docker binds 0.0.0.0, Windows forwards and allows the
# ports, and `workspace_url` is the address the Add a machine panel hands out when you're on localhost: REMI_WORKSPACE_HOST
# if set (any name or IP the other machines reach this PC by), else this PC's default-route IP. The machines are
# assumed to reach each other directly, however the network is built (LAN, VPN, ...).
lan() {
  local ip
  if [ "$(env_get REMI_LAN)" = 1 ]; then
    ip=$(env_get REMI_WORKSPACE_HOST)
    [ -n "$ip" ] || ip=$(lan_ip)
    [ -n "$ip" ] || die "couldn't find this PC's network address; check the network connection, or set REMI_WORKSPACE_HOST in .env"
    env_set REMI_BIND 0.0.0.0
    open_windows_ports
    WORKSPACE_URL="http://$ip:3000"
  else
    env_set REMI_BIND 127.0.0.1
    WORKSPACE_URL=""
  fi
}

need_token() {  # a local workspace gets its token from `up`'s publish; a joining machine mints its own and uses its code
  local_db || grep -q '^STDB_TOKEN=.\+' .env || grep -q '^REMI_JOIN_CODE=.\+' .env \
    || die "set STDB_TOKEN in .env: an admin's spacetimedb_token for $(sed -n 's/^STDB_URL=//p' .env) (docs/node-setup.md)"
}

publish() {  # publish/update the module, save the owner's token, print a one-time admin link
  local code out t
  code=$(head -c 18 /dev/urandom | base64 | tr '+/' '-_')  # 24 chars, add_admin_code's [A-Za-z0-9_-]{16,64}
  say "publishing the module to this machine's SpacetimeDB"
  out=$($D compose run --build --rm -T -e REMI_ADMIN_CODE="$code" -e REMI_WORKSPACE_URL="${WORKSPACE_URL:-}" publish) \
    || die "module publish failed (output above)"
  t=$(sed -n 's/^STDB_TOKEN=//p' <<<"$out")
  [ -n "$t" ] || die "publish gave no token"
  sed -i "s|^STDB_TOKEN=.*|STDB_TOKEN=$t|" .env
  LINK="http://localhost:8080/?claim=$code"
}

install() {
  command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1 \
    || die "no NVIDIA GPU driver. Windows: install the NVIDIA driver on Windows (not in WSL), then reopen WSL. Linux: install the driver (e.g. sudo ubuntu-drivers install) and reboot."
  command -v curl >/dev/null || { $SUDO apt-get install -y -qq curl 2>/dev/null || $SUDO dnf install -y -q curl; }
  pick_docker
  if ! $D info >/dev/null 2>&1; then
    # a fresh WSL distro sees Docker Desktop's CLI on the Windows PATH (/mnt/c/...): that isn't an engine here
    case "$(command -v docker)" in ""|/mnt/*) install_docker ;; esac
    $SUDO systemctl start docker 2>/dev/null || $SUDO service docker start
    pick_docker
    $D info >/dev/null 2>&1 || die "Docker is installed but not running: sudo systemctl start docker"
  fi
  $D compose version >/dev/null 2>&1 || die "docker compose v2 missing: re-run the Docker install (get.docker.com) or update Docker"
  if ! gpu_ok; then
    desktop && die "Docker Desktop can't see the GPU: update the NVIDIA driver and use the WSL2 backend (Settings > General)"
    install_toolkit
    gpu_ok || die "GPU still not visible in containers: $(tail -1 /tmp/remi-gpu.txt)"
  fi
  say "GPU in containers: $(head -1 /tmp/remi-gpu.txt)"
  keep_wsl_up
  make_env
  need_token
}

doctor() {  # check only, changes nothing
  local bad=0
  ok()   { printf '  ok    %s\n' "$1"; }
  fail() { printf '  FAIL  %s\n' "$1"; bad=1; }
  pick_docker
  nvidia-smi -L >/dev/null 2>&1 && ok "NVIDIA driver" || fail "NVIDIA driver (install it; Windows: on Windows, not in WSL)"
  $D info >/dev/null 2>&1 && ok "docker running" || fail "docker (scripts/remi install)"
  $D compose version >/dev/null 2>&1 && ok "docker compose v2" || fail "docker compose v2 (scripts/remi install)"
  gpu_ok && ok "GPU in containers: $(head -1 /tmp/remi-gpu.txt)" || fail "GPU in containers (scripts/remi install)"
  [ -f .env ] && { local_db || grep -q '^STDB_TOKEN=.\+' .env; } && ok ".env" || fail ".env / STDB_TOKEN (scripts/remi install)"
  return $bad
}

# Point this machine at another workspace with the code from its console (Config > Add a machine): only the node runs
# here, with its own identity. Checks the workspace before installing anything.
join_setup() {
  [[ "${1:-}" =~ ^(https?://[^/]+)/([A-Za-z0-9_-]+)/?$ ]] || die "usage: scripts/remi join http://<workspace-ip>:3000/<database> <code> (copy it from the console)"
  local url="${BASH_REMATCH[1]}" db="${BASH_REMATCH[2]}" code="${2:-}"
  [[ "$code" =~ ^[A-Za-z0-9_-]{16,64}$ ]] || die "that join code looks cut off: copy the whole command from Config > Add a machine"
  command -v curl >/dev/null || { $SUDO apt-get install -y -qq curl 2>/dev/null || $SUDO dnf install -y -q curl; }
  curl -fsS -m 5 "$url/v1/ping" >/dev/null 2>&1 \
    || die "can't reach $url from here. On the workspace PC run scripts/remi up --lan, and check both PCs are on the same network."
  [ "$(curl -s -m 5 -o /dev/null -w '%{http_code}' "$url/v1/database/$db/schema?version=9")" = 200 ] \
    || die "$url has no workspace called $db: copy the command again from the console"
  make_env
  env_set COMPOSE_PROFILES ""
  env_set STDB_URL "$url"
  env_set STDB_DB "$db"
  env_set STDB_TOKEN ""
  env_set REMI_JOIN_CODE "$code"
  say "joining $url/$db as $(env_get REMI_NODE_NAME)"
}

start() {  # build, fetch the model, publish if this machine hosts the workspace, start
  $D compose build \
             && say "downloading the model (once, ~8 GB; cached in the hf-cache volume)" \
             && $D compose run --rm --no-deps --entrypoint hf node download "$(sed -n 's/^BASE_MODEL=//p' .env | grep . || echo nvidia/NVIDIA-Nemotron-3-Nano-4B-BF16)" >/dev/null \
             && { ! local_db || { lan && publish; }; } \
             && $D compose up -d \
             && say "starting. vLLM takes 1-4 minutes to warm up: scripts/remi status" \
             && { [ -z "${LINK:-}" ] || say "open the console as admin (one use): $LINK"; } \
             && { [ -z "${WORKSPACE_URL:-}" ] || say "open to your network at $WORKSPACE_URL: add a PC from Config > Add a machine (console for other PCs: ${WORKSPACE_URL%:3000}:8080)"; }
}

case "${1:-}" in
  install) install && say "ready: scripts/remi up" ;;
  up)      case "${2:-}" in --lan) make_env; env_set REMI_LAN 1 ;; --no-lan) make_env; env_set REMI_LAN 0 ;; "") ;; *) die "unknown option ${2}: use --lan or --no-lan" ;; esac
           install && start ;;
  join)    join_setup "${2:-}" "${3:-}" && install && start && say "this machine shows up in the console under Nodes once vLLM is ready" ;;
  down)    pick_docker; $D compose down ;;
  status)  pick_docker; $D compose ps
           $D compose exec -T node python3 -c "from remi.serving.launch import ready; print('vllm: ready' if ready() else 'vllm: starting')" 2>/dev/null \
             || echo "node: not running"
           $D compose exec -T node sh -c 'tail -1 /store/vllm.log 2>/dev/null | cut -c1-160' 2>/dev/null ;;  # what vLLM is doing now
  logs)    pick_docker; $D compose logs -f --tail 100 node ;;
  doctor)  doctor ;;
  *)       echo "usage: scripts/remi install | up [--lan|--no-lan] | join <url>/<db> <code> | down | status | logs | doctor" >&2; exit 2 ;;
esac
