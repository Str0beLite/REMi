{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Str0beLite/REMi/contract/train_spec.schema.json",
  "title": "REMi train spec (written by /train_spec, read by /sleep)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "base", "datasets", "rank", "lr", "epochs", "targets", "out", "desc"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" },
    "base": { "type": "string", "minLength": 1 },
    "datasets": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" } },
    "rank": { "type": "integer", "minimum": 1, "maximum": 64 },
    "lr": { "type": "number", "minimum": 0.00001, "maximum": 0.001 },
    "epochs": { "type": "integer", "minimum": 1, "maximum": 3 },
    "targets": { "enum": ["attn", "mlp", "attn+mlp"] },
    "out": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" },
    "desc": { "type": "string", "maxLength": 500 }
  }
}
